{
  "name": "rapbrawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAPBRAWL - competitive 2.5D fighting game",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.186.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "playwright": "1.56.1"
  }
}
